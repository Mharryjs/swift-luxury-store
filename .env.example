# AI Studio System Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# PostgreSQL Database
DATABASE_URL="postgresql://swif_user:your_secure_password@localhost:5432/swif_ecommerce"

# Security & Session Secret
SECRET_KEY="generate-a-strong-32-character-random-secret-key-here"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="https://swif.site/auth/google/callback"

# SMTP Mail Infrastructure (Configured for sswiftsite@gmail.com)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="sswiftsite@gmail.com"
SMTP_PASSWORD="your-secure-app-password"
SMTP_FROM_EMAIL="sswiftsite@gmail.com"

# Official Brand Standard
OFFICIAL_SUPPORT_EMAIL="sswiftsite@gmail.com"
OFFICIAL_INSTAGRAM_URL="https://www.instagram.com/swif.site"

